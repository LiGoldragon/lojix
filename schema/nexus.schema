;; lojix Nexus plane schema — daemon-owned.
;;
;; Runtime implementation schema, not a Signal contract. It imports the
;; ordinary/meta Signal roots and the local SEMA roots, then names the lojix
;; daemon's decision/effect language. Shape follows cloud/schema/nexus.schema
;; exactly: imports block, [NexusWork] / [NexusAction] operation roots, then
;; the record body that declares SignalInput/SignalOutput unions, the
;; EffectCommand catalog (= the deploy pipeline), EffectResult, and the
;; NexusWork/NexusAction model.
;;
;; The nexus schema is the engine FEATURE CATALOG (record z6qu): every
;; internal feature of the lojix daemon is a declared Nexus verb+object here
;; and nowhere inline. The deploy pipeline — eval, build, copy-closure,
;; activate, gc — is the EffectCommand catalog; the durable live-set / gc /
;; event-log / container-lifecycle planes are the SEMA roots.
;;
;; LOCAL-BUILD PATH (honoring the dropped hallucinated guard 783n + intent
;; 1orezxnzgedct1grkn4): NixBuild carries an explicit local-vs-remote build
;; target so a builder-absent deploy lowers to a local-dispatcher build and is
;; NEVER rejected for a missing builder. The contract surface already carries
;; no local-build guard (meta-signal-lojix.lib.schema:38-41); this nexus
;; effect catalog keeps the same discipline by modeling the local path as a
;; first-class BuildTarget variant rather than an error.

{
  OrdinaryInput signal-lojix:lib:Input
  OrdinaryOutput signal-lojix:lib:Output
  MetaInput meta-signal-lojix:lib:Input
  MetaOutput meta-signal-lojix:lib:Output
  SemaReadInput lojix:sema:SemaReadInput
  SemaReadOutput lojix:sema:SemaReadOutput
  SemaWriteInput lojix:sema:SemaWriteInput
  SemaWriteOutput lojix:sema:SemaWriteOutput
  ClusterName signal-lojix:lib:ClusterName
  NodeName signal-lojix:lib:NodeName
  ClosurePath signal-lojix:lib:ClosurePath
  FlakeReference signal-lojix:lib:FlakeReference
  ProposalSource signal-lojix:lib:ProposalSource
  UserName signal-lojix:lib:UserName
  GenerationIdentifier signal-lojix:lib:GenerationIdentifier
  DeploymentIdentifier signal-lojix:lib:DeploymentIdentifier
  GenerationSlot signal-lojix:lib:GenerationSlot
  ActivationKind signal-lojix:lib:ActivationKind
  SystemAction signal-lojix:lib:SystemAction
  DeploymentKind signal-lojix:lib:DeploymentKind
  HomeMode meta-signal-lojix:lib:HomeMode
}
[NexusWork]
[NexusAction]
{
  SignalInput [(OrdinaryInput OrdinaryInput) (MetaInput MetaInput)]
  SignalOutput [(OrdinaryOutput OrdinaryOutput) (MetaOutput MetaOutput)]

  BuilderNode { NodeName * }
  BuildTarget [Local (Remote BuilderNode)]
  ExtraSubstituter { url String public_key String }

  FlakeAuthRequest { source ProposalSource flake FlakeReference }
  ResolvedFlake { flake FlakeReference revision String }
  HomeMaterialization { UserName * }
  MaterializationShape [FullOs OsOnly (Home HomeMaterialization)]
  HorizonMaterializationCommand { ClusterName * NodeName * source ProposalSource shape MaterializationShape }
  FlakeInputReference { url String nix_archive_hash String }
  FlakeInputOverride { name String reference FlakeInputReference }
  MaterializedInputs { overrides (Vec FlakeInputOverride) }
  NixEvalCommand { ClusterName * NodeName * DeploymentKind * flake FlakeReference attribute String overrides (Vec FlakeInputOverride) }
  NixBuildCommand { GenerationIdentifier * ClosurePath * target BuildTarget substituters (Vec ExtraSubstituter) }
  CopyClosureCommand { GenerationIdentifier * ClusterName * NodeName * ClosurePath * source BuildTarget }
  HomeActivationProfile { mode HomeMode user UserName }
  ActivationProfile [(System SystemAction) (Home HomeActivationProfile)]
  ActivateGenerationCommand { GenerationIdentifier * ClusterName * NodeName * ClosurePath * ActivationKind * profile ActivationProfile }
  PathInfoGcCommand { ClusterName * NodeName * }

  ;; HERMETIC test dispatch (report 54 §5.2). Build the pre-declared
  ;; auto-pickup nixos test `<flake>#checks.<system>.vm-<node>` (the
  ;; runNixOSTest engine owns its own sandboxed VM — no SSH, no tap, no live
  ;; host). Pass/fail IS the build exit status; the realised out-path is the
  ;; check's closure. The daemon is a pure dispatcher selecting a check by
  ;; name — no nix authoring at runtime.
  HermeticCheckCommand { ClusterName * NodeName * flake FlakeReference system String }
  CheckBuilt { ClusterName * NodeName * ClosurePath * }

  ;; LIVE test dispatch (report 54 §5.2, report 47 v2 / report 51 §3). Two
  ;; daemon-owned effects bracket the existing deploy chain: BringUpTestVm
  ;; brings up the generated microVM + additive tap inside a user network
  ;; namespace on the resolved vmhost (the report-51 host-untouched
  ;; user-level bring-up — `ssh <host-fqdn>` + `systemd-run --user` +
  ;; `unshare -rn` + `nsenter`, no sudo, no switch-to-configuration);
  ;; TearDownTestVm stops the user units so the tap + route vanish with the
  ;; namespace, host netns byte-identical. BUILT but NOT run live here (the
  ;; first Prometheus cycle is psyche-gated).
  BringUpTestVmCommand { ClusterName * NodeName * host NodeName runner ClosurePath guest_ip String }
  TearDownTestVmCommand { ClusterName * NodeName * host NodeName }
  TestVmBroughtUp { ClusterName * NodeName * host NodeName }
  TestVmTornDown { ClusterName * NodeName * host NodeName }

  ;; LIVE deploy-into-VM + assert (report 54 §5.2; the middle of the live
  ;; bracket between BringUpTestVm and TearDownTestVm). DeployIntoTestVm copies
  ;; the closure under test into the running guest over `nix copy --to
  ;; ssh-ng://root@<guest_ip>` and activates it (switch-to-configuration on the
  ;; guest's copied store path) — never on the host. AssertTestVm runs the
  ;; guest-side verdict over SSH: the assertion confirms the activated system
  ;; generation IS the deployed closure (the live success criterion). Pass/fail
  ;; is the SSH exit status; a recorded Passed is earned by a real guest verdict,
  ;; never faked. The two effects map one-to-one onto the existing
  ;; Deploying/Asserting phases and the Deploy/Assert FailureStages.
  DeployIntoTestVmCommand { ClusterName * NodeName * guest_ip String closure ClosurePath }
  AssertTestVmCommand { ClusterName * NodeName * guest_ip String closure ClosurePath }
  TestVmDeployedInto { ClusterName * NodeName * ClosurePath * }
  TestVmAsserted { ClusterName * NodeName * ClosurePath * }

  EffectCommand [(ResolveFlakeAuth FlakeAuthRequest) (MaterializeHorizon HorizonMaterializationCommand) (NixEval NixEvalCommand) (NixBuild NixBuildCommand) (CopyClosure CopyClosureCommand) (ActivateGeneration ActivateGenerationCommand) (PathInfoGc PathInfoGcCommand) (HermeticCheck HermeticCheckCommand) (BringUpTestVm BringUpTestVmCommand) (TearDownTestVm TearDownTestVmCommand) (DeployIntoTestVm DeployIntoTestVmCommand) (AssertTestVm AssertTestVmCommand)]

  EvaluatedClosure { GenerationIdentifier * ClosurePath * }
  BuiltClosure { GenerationIdentifier * ClosurePath * }
  CopiedClosure { GenerationIdentifier * NodeName * ClosurePath * }
  ActivatedGeneration { GenerationIdentifier * NodeName * GenerationSlot * }
  GarbageCollected { ClusterName * NodeName * reclaimed_paths Integer }
  EffectFailure { stage EffectStage detail String }
  EffectStage [FlakeAuth MaterializeHorizon Eval Build CopyClosure Activate Gc HermeticCheck BringUpTestVm TearDownTestVm DeployIntoTestVm AssertTestVm]

  EffectResult [(FlakeResolved ResolvedFlake) (HorizonMaterialized MaterializedInputs) (ClosureEvaluated EvaluatedClosure) (ClosureBuilt BuiltClosure) (ClosureCopied CopiedClosure) (GenerationActivated ActivatedGeneration) (PathsCollected GarbageCollected) (HermeticCheckBuilt CheckBuilt) (TestVmBroughtUp TestVmBroughtUp) (TestVmTornDown TestVmTornDown) (TestVmDeployedInto TestVmDeployedInto) (TestVmAsserted TestVmAsserted) (EffectFailed EffectFailure)]

  NexusWork [(SignalArrived SignalInput) (SemaReadCompleted SemaReadOutput) (SemaWriteCompleted SemaWriteOutput) (EffectCompleted EffectResult)]
  NexusAction [(CommandSemaRead SemaReadInput) (CommandSemaWrite SemaWriteInput) (CommandEffect EffectCommand) (ReplyToSignal SignalOutput) (Continue NexusWork)]
}

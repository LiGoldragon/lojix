  CopyCommand [Text]
  ActivationCommand [Text]
  StateHash [Text]
  DatabaseMarker [TransactionCounter StateHash]
  AcceptedReply [DeploymentIdentifier DatabaseMarker]
  RejectedReply [RejectionReason DatabaseMarker]
  ObservedReply [ObservationRecord DatabaseMarker]
  SnapshotReply [GenerationRecord DatabaseMarker]
  HelpAnswerReply [HelpReply DatabaseMarker]
  Toolchain [BuildCommand CopyCommand ActivationCommand]
  DaemonConfiguration [SocketPath StateDirectory GcRootDirectory SemaDatabasePath Toolchain]
  DeploymentRequest [HorizonView TargetNode CriomeAuthorization]
  GenerationSelector [DeploymentIdentifier]
  HelpQuery [Detail]
  PlanRecord [DeploymentIdentifier HorizonView TargetNode]
  BuildRecord [GenerationIdentifier ClosurePath BuildLog]
  CopyRecord [GenerationIdentifier TargetNode ClosurePath]
  ActivationRecord [GenerationIdentifier TargetNode ActivationKind]
  GenerationRecord [GenerationIdentifier DeploymentIdentifier TargetNode ClosurePath ActivationKind]
  ObservationRecord [DeploymentIdentifier Phase Status Detail]
  Phase (PlanReceived Authorized Building CopyingClosure Activating Observed Failed)
  Status (Started Progressing Complete Failed)
  CriomeAuthorization (Bypass OperatorAllowlist Criome)
  RejectionReason (Unauthorized PolicyViolation MalformedRequest CapacityExhausted)
  ActivationKind (Switch Boot Test)
  MailLifecycle (Sent Queued Processing Replied Failed)
  SemaCommand (
    (RecordPlan PlanRecord)
    (RecordBuild BuildRecord)
    (RecordCopy CopyRecord)
    (RecordActivation ActivationRecord)
    (RecordObservation ObservationRecord)
    (QueryGeneration GenerationSelector)
  )
  SemaResponse (
    (Acknowledged SemaCommandIdentifier)
    (GenerationLedgerEntry GenerationRecord)
    (ObservationStreamEntry ObservationRecord)
    (Missed Detail)
  )
  ActorRequest (
    (AuthorizeDeployment DeploymentRequest)
    (MaterializePlan DeploymentRequest)
    (ExecuteBuild PlanRecord)
    (CopyClosure BuildRecord)
    (ActivateGeneration CopyRecord)
    (PinGenerationRoot BuildRecord)
    (EmitObservation ObservationRecord)
  )
  ActorReply (
    (AuthorizationDecided CriomeAuthorization)
    (PlanReady PlanRecord)
    (BuildComplete BuildRecord)
    (CopyComplete CopyRecord)
    (ActivationComplete ActivationRecord)
    (PinReceipt GenerationIdentifier)
    (ObservationAccepted ObservationIdentifier)
  )

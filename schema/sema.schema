;; lojix SEMA plane schema — daemon-owned.
;;
;; Runtime implementation schema, not a Signal contract. It names lojix daemon
;; durable state reads, writes, and table identity. Shape follows
;; cloud/schema/sema.schema exactly: imports block, [SemaReadInput
;; SemaWriteInput] / [SemaReadOutput SemaWriteOutput] operation roots, then a
;; record body declaring the read/write operation variants, the typed reply
;; unions, the StateMarker, and the durable table records.
;;
;; The four durable tables are the lojix state plane: the live generation set,
;; the GC-roots retention tree, the append-only event log, and the
;; container-lifecycle mirror (lojix/ARCHITECTURE.md:44-65). Each is declared
;; here as a table record; the daemon registers each family with sema-engine
;; at startup.

{
  Selection signal-lojix:lib:Selection
  GenerationListing signal-lojix:lib:GenerationListing
  Generation signal-lojix:lib:Generation
  KeyMaterialQuery signal-lojix:lib:KeyMaterialQuery
  KeyMaterialReport signal-lojix:lib:KeyMaterialReport
  EventLogRange signal-lojix:lib:EventLogRange
  EventLogPosition signal-lojix:lib:EventLogPosition
  DeploymentPhaseEvent signal-lojix:lib:DeploymentPhaseEvent
  CacheRetentionTransitionEvent signal-lojix:lib:CacheRetentionTransitionEvent
  ClusterName signal-lojix:lib:ClusterName
  NodeName signal-lojix:lib:NodeName
  PinLabel signal-lojix:lib:PinLabel
  ClosurePath signal-lojix:lib:ClosurePath
  DeploymentIdentifier signal-lojix:lib:DeploymentIdentifier
  GenerationIdentifier signal-lojix:lib:GenerationIdentifier
  ContainedRunIdentifier signal-lojix:lib:ContainedRunIdentifier
  ProposalSource signal-lojix:lib:ProposalSource
  FlakeReference signal-lojix:lib:FlakeReference
  DeploymentKind signal-lojix:lib:DeploymentKind
  ActivationKind signal-lojix:lib:ActivationKind
  GenerationSlot signal-lojix:lib:GenerationSlot
  ContainedTarget signal-lojix:lib:ContainedTarget
  ContainedClosurePath signal-lojix:lib:ContainedClosurePath
  AcceptedContainedDeploy signal-lojix:lib:AcceptedContainedDeploy
  ContainedVerification signal-lojix:lib:ContainedVerification
  VerificationBody signal-lojix:lib:VerificationBody
  ContainedVerificationReport signal-lojix:lib:ContainedVerificationReport
  RejectedContainedVerification signal-lojix:lib:RejectedContainedVerification
  ContainedRelease signal-lojix:lib:ContainedRelease
  AppliedContainedRelease signal-lojix:lib:AppliedContainedRelease
  RejectedRelease signal-lojix:lib:RejectedRelease
  ContainedRunRecord signal-lojix:lib:ContainedRunRecord
  ContainedRunListing signal-lojix:lib:ContainedRunListing
  ContainedRunLookup signal-lojix:lib:ContainedRunLookup
  ContainedRunPhase signal-lojix:lib:ContainedRunPhase
  ContainedOutcome signal-lojix:lib:ContainedOutcome
  FailureStage signal-lojix:lib:FailureStage
  SystemDeployment meta-signal-lojix:lib:SystemDeployment
  HomeDeployment meta-signal-lojix:lib:HomeDeployment
  PinRequest meta-signal-lojix:lib:PinRequest
  UnpinRequest meta-signal-lojix:lib:UnpinRequest
  RetireRequest meta-signal-lojix:lib:RetireRequest
  AcceptedDeploy meta-signal-lojix:lib:AcceptedDeploy
  AppliedPin meta-signal-lojix:lib:AppliedPin
  AppliedUnpin meta-signal-lojix:lib:AppliedUnpin
  AppliedRetire meta-signal-lojix:lib:AppliedRetire
}
[SemaReadInput SemaWriteInput]
[SemaReadOutput SemaWriteOutput]
{
  SemaReadInput [(QueryGenerations Selection) (ReadEventLog EventLogRange) (CheckKeyMaterial KeyMaterialQuery) (QueryContainedRuns ContainedRunLookup) (VerifyContainedRun ContainedVerification)]

  SemaReadOutput [(GenerationsQueried GenerationListing) (EventLogRead EventLogPage) (KeyMaterialChecked KeyMaterialReport) (ContainedRunsQueried ContainedRunListing) (ContainedVerificationPrepared ContainedVerificationPlan) (ContainedVerified ContainedVerificationReport) (ContainedVerificationRejected RejectedContainedVerification) (ReadMissed RejectionReport)]
  ContainedVerificationPlan { ContainedRunRecord ContainedVerification }
  DeploymentEvents (Vector DeploymentPhaseEvent)
  RetentionEvents (Vector CacheRetentionTransitionEvent)
  EventLogPage { DeploymentEvents RetentionEvents StateMarker }

  ;; RecordContainedRun persists one already-lowered contained-run row (the Unit-2a stub
  ;; writes it at phase Submitted / outcome Pending) and replies the accepted
  ;; handle, mirroring RecordDeploySubmitted -> DeploySubmitted. Unit 2b
  ;; rewrites the row at each phase transition as the real dispatch runs.
  SemaWriteInput [(RecordDeploySubmitted DeploySubmission) (RecordPhaseTransition DeploymentPhaseEvent) (RecordGenerationActivated ActivationCommit) (PinGeneration PinRequest) (UnpinGeneration UnpinRequest) (RetireGeneration RetireRequest) (RecordContainerTransition ContainerTransition) (RecordContainedRun ContainedRunRecord) (ReleaseContainedRun ContainedRelease)]
  DeploySubmission [(System SystemDeployment) (Home HomeDeployment)]
  ActivationCommit { GenerationIdentifier ClusterName NodeName GenerationSlot ClosurePath }
  ContainerTransition { ClusterName NodeName container.ContainerName state.ContainerState }
  ContainerName String
  ContainerState [Starting Started Stopping Stopped Failed]

  SemaWriteOutput [(DeploySubmitted AcceptedDeploy) (PhaseRecorded PhaseReceipt) (GenerationActivated AppliedActivation) (GenerationPinned AppliedPin) (GenerationUnpinned AppliedUnpin) (GenerationRetired AppliedRetire) (ContainerRecorded ContainerReceipt) (ContainedRunRecorded AcceptedContainedDeploy) (ContainedRunReleased AppliedContainedRelease) (ContainedReleaseRejected RejectedRelease) (WriteRejected RejectionReport)]
  PhaseReceipt { EventLogPosition StateMarker }
  AppliedActivation { GenerationIdentifier GenerationSlot StateMarker }
  ContainerReceipt { EventLogPosition StateMarker }

  RejectionReport { reason.RejectionReason marker.StateMarker }
  RejectionReason [GenerationUnknown NodeUnknown ClusterUnknown PlanNotApproved PinLabelInUse PinLabelUnknown GenerationActive GenerationPinned EventLogPositionOutOfRange ProposalSourceUnreachable]
  StateMarker { CommitSequence StateDigest }
  CommitSequence Integer
  StateDigest Integer

  LiveSetEntries (Vector LiveGeneration)
  LiveSetTable { LiveSetEntries }
  LiveGeneration { DeploymentIdentifier GenerationIdentifier ClusterName NodeName DeploymentKind ActivationKind GenerationSlot ClosurePath }

  GcRoots (Vector GcRoot)
  GcRootsTable { GcRoots }
  Label (Optional PinLabel)
  GcRoot { GenerationIdentifier ClusterName NodeName GenerationSlot ClosurePath Label }

  EventLogEntries (Vector EventLogEntry)
  EventLogTable { EventLogEntries }
  EventLogEntry { EventLogPosition record.LoggedEvent }
  LoggedEvent [(Deployment DeploymentPhaseEvent) (CacheRetention CacheRetentionTransitionEvent) (Container ContainerLifecycleRecord)]

  ContainerLifecycleRecords (Vector ContainerLifecycleRecord)
  ContainerLifecycleTable { ContainerLifecycleRecords }
  ContainerLifecycleRecord { ClusterName NodeName container.ContainerName state.ContainerState EventLogPosition }

  ;; The durable in-flight deploy-job row (up9q). One row per submitted deploy,
  ;; keyed by DeploymentIdentifier. Written on submit and rewritten at every
  ;; phase transition, so a daemon restart reads the persisted cursor and
  ;; reconciles the in-flight deploy rather than losing it. The phase cursor
  ;; mirrors DeployJobPhase; resolved_target / boot_once_unit are populated as
  ;; the pipeline learns them so a resumed Activating job can poll the
  ;; transient unit instead of re-activating.
  DeployJobs (Vector DeployJob)
  DeployJobTable { DeployJobs }
  DeployJobClosurePath (Optional ClosurePath)
  ResolvedTarget (Optional String)
  BootOnceUnit (Optional String)
  DeployJob { DeploymentIdentifier GenerationIdentifier ClusterName NodeName phase.DeployJobPhase DeployJobClosurePath ResolvedTarget BootOnceUnit }
  DeployJobPhase [Submitted Building Built Copying Activating Activated Failed]

  ;; The durable contained-run table (report 54 §5.3), mirroring DeployJobTable. One
  ;; row per submitted test, keyed by ContainedRunIdentifier, written on accept at
  ;; phase Submitted / outcome Pending and rewritten at every phase transition
  ;; (Unit 2b) so a restarted daemon reconciles an in-flight test and the
  ;; (Query (ByContainedRun …)) read answers from the persisted rows. StoredContainedRun
  ;; is the lojix-LOCAL durable row (the EngineRecord key owner) mirroring the
  ;; ordinary-contract ContainedRunRecord field-for-field — the same local/wire
  ;; split LiveGeneration/Generation already uses, because EngineRecord cannot
  ;; be implemented on an imported wire type (the orphan rule).
  StoredContainedRuns (Vector StoredContainedRun)
  ContainedRunTable { StoredContainedRuns }
  StoredContainedRun {
    ContainedRunIdentifier
    ClusterName
    NodeName
    host.NodeName
    target.ContainedTarget
    ProposalSource
    FlakeReference
    phase.ContainedRunPhase
    outcome.ContainedOutcome
    ContainedClosurePath
  }
}
